async function loadPdfJs(){
  if(window.pdfjsLib)return window.pdfjsLib;
  await new Promise((res,rej)=>{const s=document.createElement('script');s.src=PDFJS;s.onload=res;
    s.onerror=()=>rej(new Error('Não foi possível carregar o leitor de PDF (é preciso estar conectado à internet).'));document.head.appendChild(s)});
  window.pdfjsLib.GlobalWorkerOptions.workerSrc=PDFJS_WORKER;return window.pdfjsLib;
}
async function pdfLines(buf){
  const lib=await loadPdfJs();let doc=null,pw;
  for(let k=0;k<5&&!doc;k++){
    try{doc=await lib.getDocument({data:new Uint8Array(buf.slice(0)),password:pw}).promise}
    catch(e){if(e&&e.name==='PasswordException'){pw=prompt(k?'Senha incorreta. Tente de novo:':'Este PDF tem senha. Digite a senha do extrato:');
        if(pw==null)throw new Error('Importação cancelada: o PDF é protegido por senha.')}else throw e}
  }
  if(!doc)throw new Error('Não foi possível abrir o PDF.');
  const lines=[];
  for(let p=1;p<=doc.numPages;p++){
    const tc=await (await doc.getPage(p)).getTextContent();
    const items=tc.items.filter(i=>i.str&&i.str.trim()).map(i=>({s:i.str,x:i.transform[4],y:i.transform[5],w:i.width||0}));
    items.sort((a,b)=>b.y-a.y||a.x-b.x);
    let cur=[],cy=null;
    const flush=()=>{if(!cur.length)return;cur.sort((a,b)=>a.x-b.x);let s='',end=null;
      for(const it of cur){s+=(end!==null&&it.x-end>1?' ':'')+it.s;end=it.x+it.w}lines.push(s.replace(/\s+/g,' ').trim());cur=[]};
    for(const it of items){if(cy===null||Math.abs(it.y-cy)<=3){cur.push(it);if(cy===null)cy=it.y}else{flush();cur=[it];cy=it.y}}
    flush();
  }
  if(lines.join('').length<30)throw new Error('Este PDF parece ser uma imagem escaneada, sem texto. Prefira exportar o extrato em CSV ou OFX.');
  return lines;
}
const MONEY_RE=/([-−+])?\s?(?:R\$\s?)?([-−])?\s?(\(?)(\d{1,3}(?:\.\d{3})+|\d+),(\d{2})(?!\d)(\)?)(?:\s?([-−]|[DC](?![A-Za-zÀ-ÿ])))?/g;
const SKIP_RE=/\b(SALDO|SALDOS|TOTAL|SUBTOTAL|LIMITE|PAGAMENTO MINIMO|VENCIMENTO|RESUMO)\b/;
function moneyFromMatch(m){
  const n=parseFloat(m[4].replace(/\./g,'')+'.'+m[5]);
  const neg=(m[1]&&m[1]!=='+')||!!m[2]||m[3]==='('||(m[7]&&m[7]!=='C');
  return neg?-n:n;
}
function parsePdfText(lines,opt){
  const out=[];let last=null;
  for(const raw of lines){
    const line=raw.replace(/\s+/g,' ').trim();if(!line)continue;
    const dm=dateAtStart(line,opt.ref);
    const rest=dm?line.slice(dm.len).trim():line;
    const ms=[...rest.matchAll(MONEY_RE)];
    if(dm&&!ms.length){last=dm.iso;continue}
    if(!ms.length)continue;
    const skip=SKIP_RE.test(norm(line));
    if(!dm&&(skip||!opt.carry))continue;
    const date=dm?dm.iso:last;if(!date)continue;
    const m=opt.value==='last'?ms[ms.length-1]:ms[0];
    const desc=rest.slice(0,ms[0].index).replace(/[\s\-–|:]+$/,'').trim();
    if(!/[A-Za-zÀ-ÿ]/.test(desc))continue;
    out.push({date,desc,amount:round2(moneyFromMatch(m)),suspect:skip,flag:dm?'':'data repetida'});
    if(dm)last=dm.iso;
  }
  return out;
}

