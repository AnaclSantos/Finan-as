  on('#iAcc','change',e=>{IMP.accountId=e.target.value;if(IMP.preview){markDups();renderPreview()}});
  on('#iRef','change',e=>{IMP.ref=e.target.value||todayYM();rebuild()});
  on('#iFile','change',e=>{const f=e.target.files[0];if(f)handleFile(f)});
  const drop=$('#drop');
  ['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('on')}));
  ['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('on')}));
  drop.addEventListener('drop',e=>{const f=e.dataTransfer.files[0];if(f)handleFile(f)});
  main.onclick=e=>{const u=e.target.dataset.undo,dt=e.target.dataset.deltpl;
    if(u)undoImport(u);
    if(dt&&confirm('Excluir este modelo?')){S.templates=S.templates.filter(t=>t.id!==dt);save();renderImport()}};
  if(IMP.kind==='csv')renderCsvMap();
  if(IMP.kind==='pdf')renderPdfOpts();
  if(IMP.preview)renderPreview();
}
async function handleFile(file){
  resetImp();IMP.fileName=file.name;
  const ext=file.name.split('.').pop().toLowerCase();
  try{
    const buf=await file.arrayBuffer();
    if(ext==='pdf'){toast('Lendo o PDF…');IMP.pdf=await pdfLines(buf);IMP.kind='pdf';rebuild(true)}
    else{const text=decodeText(buf);
      if(ext==='ofx'||ext==='qfx'||/<OFX>/i.test(text)){IMP.kind='ofx';setPreview(parseOFX(text))}
      else{IMP.kind='csv';IMP.raw={text,rows:[]};
        let tpl=null;
        for(const t of S.templates){const rows=parseCSV(text,t.map.delimiter);if(csvSig(rows,t.map)===t.sig){tpl=t;IMP.raw.rows=rows;break}}
        if(tpl){IMP.map={...tpl.map};IMP.tplId=tpl.id;IMP.note=`Modelo “${tpl.name}” reconhecido e aplicado.`}
        else{const d=detectDelim(text);IMP.raw.rows=parseCSV(text,d);IMP.map=guessMapping(IMP.raw.rows,d)}
        rebuild(true)}}
  }catch(e){console.error(e);toast(e.message||String(e),true);resetImp()}
  renderImport();
}
function rebuild(keepNote){
  const note=IMP.note;
  if(IMP.kind==='csv')setPreview(applyMapping(IMP.raw.rows,IMP.map,IMP.ref));
  else if(IMP.kind==='pdf')setPreview(parsePdfText(IMP.pdf,{...IMP.pdfOpt,ref:IMP.ref}));
  else return;
  if(keepNote&&note)IMP.note=note+(IMP.note&&IMP.note!==note?' '+IMP.note:'');
  if($('#iStep3'))renderPreview();
}
function setPreview(items){
  IMP.note='';
  IMP.preview=items.map(it=>({...it,categoryId:ruleMatch(it.desc),checked:!it.suspect,dup:false}));
  const acc=accById(IMP.accountId);
  if(acc&&acc.type==='cartao'&&IMP.kind!=='ofx'&&IMP.preview.length&&IMP.preview.filter(r=>r.amount>0).length>IMP.preview.length/2){
    IMP.preview.forEach(r=>r.amount=-r.amount);
    IMP.note='Como é um cartão e a maioria dos valores veio positiva, os sinais foram invertidos para as compras aparecerem como gasto.';
  }
  markDups();
}
function markDups(){
  const counts={};for(const t of S.transactions)if(t.accountId===IMP.accountId)counts[t.hash]=(counts[t.hash]||0)+1;
  for(const r of IMP.preview){const was=r.dup,h=hashOf(IMP.accountId,r);
    if(counts[h]>0){counts[h]--;r.dup=true;r.checked=false}else{r.dup=false;if(was)r.checked=!r.suspect}}
}
function colOpts(n,sel,H,allowNone){
  let h=allowNone?`<option value="-1" ${sel<0?'selected':''}>— nenhuma —</option>`:'';
