function commitImport(){
  const sel=IMP.preview.filter(r=>r.checked&&/^\d{4}-\d{2}-\d{2}$/.test(r.date)&&!isNaN(r.amount));
  if(!sel.length)return;
  const imp={id:uid(),at:new Date().toISOString(),file:IMP.fileName,accountId:IMP.accountId,count:sel.length};
  for(const r of sel){const t={id:uid(),accountId:IMP.accountId,date:r.date,desc:r.desc.trim()||'(sem descrição)',amount:round2(r.amount),categoryId:r.categoryId||null,importId:imp.id};
    t.hash=hashOf(t.accountId,t);S.transactions.push(t)}
  S.imports.unshift(imp);save();
  const lastM=sel.map(r=>r.date.slice(0,7)).sort().pop();
  toast(`${sel.length} lançamentos importados para ${accById(IMP.accountId).name}.`);
  resetImp();selMonth=lastM;F={month:lastM,acc:imp.accountId,cat:'',q:''};go('transacoes');
}
