  on('#rAdd','click',()=>{const p=$('#rP').value.trim(),c=$('#rC').value;if(!p||!c){toast('Informe o texto e a categoria.',true);return}
    S.rules.push({id:uid(),pattern:p,categoryId:c});const n=applyRules(false);toast(`Regra criada. ${n} transações categorizadas.`);renderCats()});
  on('#rApply','click',()=>{const n=applyRules(false);toast(`${n} transações categorizadas.`);renderCats()});
  on('#rAll','click',()=>{if(!confirm('Reaplicar as regras a todas as transações? Categorias escolhidas à mão podem ser trocadas quando houver regra.'))return;
    const n=applyRules(true);toast(`${n} transações atualizadas.`);renderCats()});
  main.onchange=e=>{const d=e.target.dataset;
    if(d.cid){const c=catById(d.cid);c[d.f]=d.f==='budget'?(parseFloat(e.target.value)||0):e.target.value;save();if(d.f==='kind')renderCats()}
    if(d.rid){const r=S.rules.find(x=>x.id===d.rid);r[d.f]=e.target.value;save()}};
  main.onclick=e=>{const d=e.target.dataset;
    if(d.delcat){const c=catById(d.delcat);if(!confirm(`Excluir a categoria “${c.name}”? As transações ficarão sem categoria.`))return;
      S.categories=S.categories.filter(x=>x.id!==c.id);S.rules=S.rules.filter(r=>r.categoryId!==c.id);
      S.transactions.forEach(t=>{if(t.categoryId===c.id)t.categoryId=null});save();renderCats()}
    if(d.delrule){S.rules=S.rules.filter(r=>r.id!==d.delrule);save();renderCats()}};
}

/* ================= backup ================= */
function exportJSON(){
  S.meta.lastBackup=new Date().toISOString();save();
  download(`financas-backup-${todayISO()}.json`,JSON.stringify({app:'caixa-pessoal',exportedAt:S.meta.lastBackup,...S},null,1),'application/json');
  renderBanner();if(tab==='backup')renderBackup();
}
function exportCSV(){
  const q=s=>`"${String(s).replace(/"/g,'""')}"`;
  const lines=[['Data','Conta','Descrição','Categoria','Valor'].join(';')];
  [...S.transactions].sort((a,b)=>a.date.localeCompare(b.date)).forEach(t=>lines.push([fmtDate(t.date),q(accById(t.accountId)?.name||''),q(t.desc),q(catById(t.categoryId)?.name||''),t.amount.toFixed(2).replace('.',',')].join(';')));
  download(`transacoes-${todayISO()}.csv`,'\uFEFF'+lines.join('\r\n'),'text/csv');
}
async function importJSON(file,mode){
  let d;try{d=JSON.parse(await file.text())}catch(e){toast('Arquivo JSON inválido.',true);return}
  if(!d||!Array.isArray(d.transactions)||!Array.isArray(d.accounts)){toast('Esse arquivo não parece um backup deste app.',true);return}
  delete d.app;delete d.exportedAt;
  if(mode==='replace'){if(!confirm(`Substituir todos os dados atuais por este backup (${d.accounts.length} contas, ${d.transactions.length} transações)?`))return;S=migrate(d)}
  else{let n=0;for(const k of ['accounts','categories','rules','templates','transactions','imports']){const ids=new Set(S[k].map(x=>x.id));for(const x of (d[k]||[]))if(!ids.has(x.id)){S[k].push(x);n++}}
    toast(`${n} itens novos incluídos.`)}
  save();selMonth=null;F.month=null;if(mode==='replace')toast('Backup restaurado.');renderBackup();renderBanner();
}
function renderBackup(){
  const kb=(()=>{try{return Math.round(JSON.stringify(S).length/1024)}catch(e){return 0}})();
  const lb=S.meta.lastBackup;
  $('#main').innerHTML=`<div class="stack"><div class="grid g2">
  <div class="card"><h2>Fazer backup</h2>
    <p>Tudo fica salvo apenas neste navegador, neste computador. Limpar os dados de navegação apaga tudo. Baixe o backup com frequência e guarde-o num lugar seguro.</p>
    <p class="small muted">${S.accounts.length} contas · ${S.transactions.length} transações · ${S.rules.length} regras · ${S.templates.length} modelos · cerca de ${kb} KB<br>Último backup: ${lb?new Date(lb).toLocaleString('pt-BR'):'nunca'}</p>
    <div class="row"><button class="btn p" onclick="exportJSON()">Baixar backup (JSON)</button><button class="btn" onclick="exportCSV()">Exportar transações (CSV)</button></div>
  </div>
  <div class="card"><h2>Restaurar backup</h2>
    <p class="small muted" style="margin-top:-6px">Use para levar seus dados para outro navegador ou computador.</p>
    <div class="row"><label class="f">Modo<select id="bM"><option value="merge">Juntar com os dados atuais</option><option value="replace">Substituir tudo</option></select></label>
    <label class="btn">Escolher arquivo .json<input type="file" id="bF" accept=".json,application/json" hidden></label></div>
    <hr style="border:0;border-top:1px solid var(--border);margin:18px 0">
    <h2>Apagar tudo</h2><p class="small muted">Remove contas, transações, regras e modelos deste navegador.</p>
    <button class="btn d" id="bWipe">Apagar todos os dados</button>
  </div></div></div>`;
  on('#bF','change',e=>{const f=e.target.files[0];if(f)importJSON(f,$('#bM').value)});
  on('#bWipe','click',()=>{if(!confirm('Apagar TODOS os dados deste navegador?'))return;if(!confirm('Tem certeza? Sem um backup, não há como recuperar.'))return;
    S=defaults();save();selMonth=null;F.month=null;resetImp();toast('Dados apagados.');go('painel')});
}

/* ================= início ================= */
load();
$('#nav').addEventListener('click',e=>{const t=e.target.dataset.tab;if(t)go(t)});
go(S.accounts.length?'painel':'contas');
</script>
</body>
