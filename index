<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Caixa Pessoal</title>
<style>
:root{
  --bg:#f4f5f1;--surface:#ffffff;--surface-2:#eef0ea;--text:#1c231f;--muted:#5f6a63;--border:#dce1d8;
  --accent:#2d6a4f;--accent-ink:#ffffff;--accent-soft:#dcebe2;--pos:#2a7a4b;--neg:#b03a3a;--warn:#8a5a00;--warn-soft:#fbefd5;
  --radius:10px;color-scheme:light;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#141816;--surface:#1c211e;--surface-2:#252b27;--text:#e7ebe8;--muted:#9aa49e;--border:#323a35;
  --accent:#6fbf96;--accent-ink:#0f1a14;--accent-soft:#23382c;--pos:#6fcf97;--neg:#ef8a8a;--warn:#e6b85c;--warn-soft:#3a3020;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#141816;--surface:#1c211e;--surface-2:#252b27;--text:#e7ebe8;--muted:#9aa49e;--border:#323a35;
  --accent:#6fbf96;--accent-ink:#0f1a14;--accent-soft:#23382c;--pos:#6fcf97;--neg:#ef8a8a;--warn:#e6b85c;--warn-soft:#3a3020;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{background:var(--surface);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:5}
.top{max-width:1180px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.brand{font-weight:700;font-size:17px;display:flex;align-items:center;gap:8px;margin-right:8px}
.brand i{width:20px;height:20px;border-radius:6px;background:var(--accent);display:inline-block}
nav{display:flex;gap:2px;flex-wrap:wrap}
nav button{background:none;border:0;padding:7px 11px;border-radius:8px;color:var(--muted);font:inherit;cursor:pointer}
nav button:hover{color:var(--text)}
nav button.on{background:var(--accent-soft);color:var(--text);font-weight:600}
main{max-width:1180px;margin:0 auto;padding:18px 16px 70px}
#banner{max-width:1180px;margin:0 auto;padding:0 16px}
#banner .notice{margin-top:14px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}
.grid{display:grid;gap:14px}
.g4{grid-template-columns:repeat(4,minmax(0,1fr))}
.g2{grid-template-columns:minmax(0,1.25fr) minmax(0,1fr)}
@media(max-width:860px){.g4{grid-template-columns:repeat(2,minmax(0,1fr))}.g2{grid-template-columns:1fr}}
.kpi .l{color:var(--muted);font-size:13px}.kpi .v{font-size:21px;font-weight:700;margin-top:2px;font-variant-numeric:tabular-nums}
h1{font-size:20px;margin:0}
h2{font-size:15px;margin:0 0 12px}
.row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
.row.c{align-items:center}
.sp{flex:1}
label.f{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--muted)}
label.ck{display:flex;gap:6px;align-items:center;font-size:14px}
input,select{font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:6px 9px;min-width:0;max-width:100%}
input[type=checkbox]{width:16px;height:16px;padding:0;accent-color:var(--accent)}
input[type=color]{padding:2px;width:38px;height:32px}
.btn{font:inherit;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:8px;padding:6px 13px;cursor:pointer;white-space:nowrap}
.btn:hover{background:var(--surface-2)}
.btn.p{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:600}
.btn.d{color:var(--neg)}
.btn.s{padding:3px 9px;font-size:13px}
.btn:disabled{opacity:.5;cursor:default}
table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-weight:600;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.03em;padding:8px;border-bottom:1px solid var(--border);white-space:nowrap}
td{padding:6px 8px;border-bottom:1px solid var(--border);vertical-align:middle}
.tw{overflow-x:auto}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.pos{color:var(--pos)}.neg{color:var(--neg)}.muted{color:var(--muted)}
.small{font-size:13px}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle;flex:none}
.bar{height:8px;background:var(--surface-2);border-radius:5px;overflow:hidden;margin-top:4px}
.bar>span{display:block;height:100%;border-radius:5px}
.catrow{padding:7px 0;border-bottom:1px solid var(--border)}
.catrow:last-child{border-bottom:0}
.badge{display:inline-block;font-size:11px;padding:2px 7px;border-radius:20px;background:var(--surface-2);color:var(--muted);white-space:nowrap}
.badge.w{background:var(--warn-soft);color:var(--warn)}
.notice{background:var(--warn-soft);color:var(--warn);border-radius:8px;padding:9px 12px;font-size:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.info{background:var(--accent-soft);border-radius:8px;padding:9px 12px;font-size:14px}
.empty{color:var(--muted);padding:28px;text-align:center}
.stack>*+*{margin-top:14px}
.mt{margin-top:12px}
details>summary{cursor:pointer;font-weight:600}
details[open]>summary{margin-bottom:12px}
.drop{border:2px dashed var(--border);border-radius:10px;padding:22px;text-align:center;color:var(--muted)}
.drop.on{border-color:var(--accent);background:var(--accent-soft)}
tr.off td{opacity:.45}
.pv td input[type=text]{width:100%;min-width:180px}
.pv td input[type=number]{width:115px;text-align:right}
.pv td input[type=date]{width:140px}
pre.raw{max-height:260px;overflow:auto;background:var(--surface-2);padding:10px;border-radius:8px;font-size:12px;white-space:pre-wrap}
#toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,120px);opacity:0;background:var(--text);color:var(--bg);padding:10px 14px;border-radius:10px;display:flex;gap:12px;align-items:center;transition:.25s;max-width:calc(100% - 32px);z-index:20;pointer-events:none}
#toast.show{transform:translate(-50%,0);opacity:1;pointer-events:auto}
#toast.err{background:var(--neg);color:#fff}
#toast .btn{background:transparent;color:inherit;border-color:currentColor}
</style>
</head>
<body>
<header><div class="top">
  <div class="brand"><i></i>Caixa Pessoal</div>
  <nav id="nav">
    <button data-tab="painel">Painel</button>
    <button data-tab="transacoes">Transações</button>
    <button data-tab="importar">Importar</button>
    <button data-tab="contas">Contas</button>
    <button data-tab="categorias">Categorias e regras</button>
    <button data-tab="backup">Backup</button>
  </nav>
</div></header>
<div id="banner"></div>
<main id="main"></main>
<div id="toast"></div>

<script>
'use strict';
/* ================= utilidades ================= */
const KEY='caixa-pessoal-v1';
const PDFJS='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
const PDFJS_WORKER='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>[...r.querySelectorAll(s)];
const uid=()=>Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-5);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad=n=>String(n).padStart(2,'0');
const BRL=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const money=v=>BRL.format(v||0);
const round2=v=>Math.round(v*100)/100;
const todayISO=()=>{const d=new Date();return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`};
const todayYM=()=>todayISO().slice(0,7);
const fmtDate=iso=>iso?`${iso.slice(8,10)}/${iso.slice(5,7)}/${iso.slice(0,4)}`:'';
const MES=['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
const monthLabel=ym=>ym?`${MES[+ym.slice(5,7)-1]}/${ym.slice(0,4)}`:'';
const addMonths=(ym,n)=>{let y=+ym.slice(0,4),m=+ym.slice(5,7)-1+n;y+=Math.floor(m/12);m=((m%12)+12)%12;return `${y}-${pad(m+1)}`};
const norm=s=>String(s??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/\s+/g,' ').trim();
const reEsc=s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
function on(sel,ev,fn,root=document){const el=typeof sel==='string'?$(sel,root):sel;if(el)el.addEventListener(ev,fn);return el}
function toast(msg,err,action){
  const t=$('#toast');
  t.innerHTML=`<span>${esc(msg)}</span>`+(action?`<button class="btn s">${esc(action.label)}</button>`:'');
  t.className='show'+(err?' err':'');
  if(action)t.querySelector('button').onclick=()=>{t.className='';action.fn()};
  clearTimeout(t._h);t._h=setTimeout(()=>t.className='',action?9000:4000);
}
function download(name,content,type){
  const b=new Blob([content],{type});const a=document.createElement('a');
  a.href=URL.createObjectURL(b);a.download=name;document.body.appendChild(a);a.click();
  setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},800);
}

/* ================= dados ================= */
const TYPES={corrente:'Conta corrente',cartao:'Cartão de crédito',poupanca:'Poupança',investimento:'Investimento',carteira:'Dinheiro'};
const KINDS={despesa:'Despesa',receita:'Receita',neutra:'Neutra (não conta)'};
const DEF_CATS=[
  ['Mercado','#4e9a6b','despesa'],['Alimentação','#e07a3f','despesa'],['Transporte','#3f7fbf','despesa'],
  ['Moradia','#8a6bbf','despesa'],['Contas da casa','#5c8d9e','despesa'],['Saúde','#d0546b','despesa'],
  ['Educação','#3aa0a0','despesa'],['Lazer','#c9a227','despesa'],['Assinaturas','#9b59b6','despesa'],
  ['Compras','#b5651d','despesa'],['Tarifas e juros','#7f8c8d','despesa'],['Outros gastos','#95a5a6','despesa'],
  ['Salário e bolsa','#2a9d5c','receita'],['Rendimentos','#1f7a8c','receita'],['Outras receitas','#6aaa64','receita'],
  ['Transferência entre contas','#a0a8a3','neutra'],['Pagamento de fatura','#b0b6b2','neutra']
];
const DEF_RULES=[['IFOOD','Alimentação'],['RAPPI','Alimentação'],['UBER','Transporte'],['99APP','Transporte'],['99 POP','Transporte'],
  ['POSTO','Transporte'],['NETFLIX','Assinaturas'],['SPOTIFY','Assinaturas'],['AMAZON PRIME','Assinaturas'],
  ['SUPERMERCADO','Mercado'],['ATACADAO','Mercado'],['ASSAI','Mercado'],['CARREFOUR','Mercado'],
  ['FARMACIA','Saúde'],['DROGARIA','Saúde'],['DROGASIL','Saúde'],
  ['PAGAMENTO DE FATURA','Pagamento de fatura'],['PAGAMENTO FATURA','Pagamento de fatura'],['PGTO FATURA','Pagamento de fatura'],['PAG FATURA','Pagamento de fatura'],['PAGAMENTO RECEBIDO','Pagamento de fatura'],
  ['SALARIO','Salário e bolsa'],['RENDIMENTO','Rendimentos'],['TARIFA','Tarifas e juros'],['IOF','Tarifas e juros'],['JUROS','Tarifas e juros']];
function defaults(){
  const cats=DEF_CATS.map(([name,color,kind])=>({id:uid(),name,color,kind,budget:0}));
  const byName=n=>cats.find(c=>c.name===n).id;
  return {version:1,accounts:[],categories:cats,
    rules:DEF_RULES.map(([p,c])=>({id:uid(),pattern:p,categoryId:byName(c)})),
    templates:[],transactions:[],imports:[],meta:{createdAt:new Date().toISOString(),lastBackup:null}};
}
function migrate(d){
  if(!Array.isArray(d.categories)||!d.categories.length){const b=defaults();d.categories=b.categories;d.rules=b.rules}
  for(const k of ['accounts','rules','templates','transactions','imports'])if(!Array.isArray(d[k]))d[k]=[];
  d.meta=d.meta||{};d.version=1;return d;
}
let S,storageOk=true;
function load(){
  try{const raw=localStorage.getItem(KEY);S=raw?migrate(JSON.parse(raw)):defaults()}
  catch(e){S=defaults();storageOk=false}
}
function save(){
  try{localStorage.setItem(KEY,JSON.stringify(S));storageOk=true}
  catch(e){storageOk=false;toast('Não foi possível salvar no navegador. Exporte um backup agora.',true)}
}
const accById=id=>S.accounts.find(a=>a.id===id);
const catById=id=>S.categories.find(c=>c.id===id);
const hashOf=(acc,t)=>`${acc}|${t.date}|${Number(t.amount).toFixed(2)}|${norm(t.desc).replace(/[^A-Z0-9]/g,'').slice(0,40)}`;
function catOpts(sel,noneLabel='— sem categoria —'){
  const groups={despesa:[],receita:[],neutra:[]};
  S.categories.forEach(c=>(groups[c.kind]||groups.despesa).push(c));
  let h=`<option value="">${noneLabel}</option>`;
  for(const k of ['despesa','receita','neutra'])if(groups[k].length)
    h+=`<optgroup label="${KINDS[k]}">`+groups[k].map(c=>`<option value="${c.id}" ${c.id===sel?'selected':''}>${esc(c.name)}</option>`).join('')+'</optgroup>';
  return h;
}
const accOpts=sel=>S.accounts.map(a=>`<option value="${a.id}" ${a.id===sel?'selected':''}>${esc(a.name)}</option>`).join('');

/* regras de categorização: o texto precisa começar numa "palavra" da descrição */
function ruleMatch(desc){
  const d=norm(desc);let best=null,bl=0;
  for(const r of S.rules){const p=norm(r.pattern);if(!p||!catById(r.categoryId))continue;
    if(new RegExp('(^|[^A-Z0-9])'+reEsc(p)).test(d)&&p.length>bl){best=r;bl=p.length}}
  return best?best.categoryId:null;
}
function applyRules(all){
  let n=0;for(const t of S.transactions){if(!all&&t.categoryId)continue;const c=ruleMatch(t.desc);if(c&&c!==t.categoryId){t.categoryId=c;n++}}
  save();return n;
}

/* totais do mês: neutras não contam; estorno em categoria de despesa reduz o gasto */
function monthTotals(ym){
  let inc=0,exp=0;const byCat={};
  for(const t of S.transactions){if(!t.date.startsWith(ym))continue;
    const c=catById(t.categoryId);if(c&&c.kind==='neutra')continue;
    if(c&&c.kind==='despesa'){exp-=t.amount;byCat[c.id]=(byCat[c.id]||0)-t.amount}
    else if(c&&c.kind==='receita'){inc+=t.amount}
    else if(t.amount>0)inc+=t.amount;
    else{exp-=t.amount;byCat._=(byCat._||0)-t.amount}}
  return {inc,exp,byCat};
}
const accBalance=(a,ym)=>(+a.initial||0)+S.transactions.reduce((s,t)=>t.accountId===a.id&&(!ym||t.date.slice(0,7)<=ym)?s+t.amount:s,0);
const monthsWithData=()=>[...new Set(S.transactions.map(t=>t.date.slice(0,7)))].sort();

/* ================= leitura de valores e datas ================= */
function parseMoney(raw,dec='auto'){
  if(raw==null)return NaN;let s=String(raw).trim();if(!s)return NaN;
  let neg=false;
  if(/^\(.*\)$/.test(s)){neg=true;s=s.slice(1,-1)}
  s=s.replace(/R\$|BRL/gi,'').replace(/\s/g,'').replace(/\u2212/g,'-');
  if(/[Dd]$/.test(s)){neg=true;s=s.slice(0,-1)}else if(/[Cc]$/.test(s))s=s.slice(0,-1);
  if(s.endsWith('-')){neg=true;s=s.slice(0,-1)}
  if(s.startsWith('-')){neg=true;s=s.slice(1)}else if(s.startsWith('+'))s=s.slice(1);
  if(!/^[\d.,]+$/.test(s)||!/\d/.test(s))return NaN;
  let d=dec;
  if(d==='auto'){const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');
    if(lc>=0&&ld>=0)d=lc>ld?',':'.';else if(lc>=0)d=',';else if(ld>=0)d=/^\d{1,3}(\.\d{3})+$/.test(s)?',':'.';else d=','}
  s=d===','?s.replace(/\./g,'').replace(',','.'):s.replace(/,/g,'');
  const n=parseFloat(s);return isNaN(n)?NaN:(neg?-n:n);
}
function mkDate(d,m,y,ref){
  if(!(m>=1&&m<=12&&d>=1&&d<=31))return null;
  let yy;if(y){yy=+y;if(yy<100)yy+=2000}else{const r=ref||todayYM();const ry=+r.slice(0,4),rm=+r.slice(5,7);yy=m>rm?ry-1:ry}
  const dt=new Date(yy,m-1,d);if(dt.getMonth()!==m-1)return null;
  return `${yy}-${pad(m)}-${pad(d)}`;
}
function dateAtStart(line,ref){
  let m=line.match(/^(\d{1,2})[\/.\-](\d{1,2})(?:[\/.\-](\d{4}|\d{2}))?(?=\s|$)/);
  if(m){const iso=mkDate(+m[1],+m[2],m[3],ref);return iso?{iso,len:m[0].length}:null}
  m=line.match(/^(\d{1,2})\s?(?:de\s)?(jan|fev|mar|abr|mai|jun|jul|ago|set|out|nov|dez)[a-zà-ÿ]*\.?(?:\s?(?:de\s)?(\d{4}))?(?=\s|$)/i);
  if(m){const iso=mkDate(+m[1],MES.indexOf(m[2].toLowerCase())+1,m[3],ref);return iso?{iso,len:m[0].length}:null}
  return null;
}
function parseDateCell(raw,fmt,ref){
  const s=String(raw??'').trim();let m;if(!s)return null;
  if((m=s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/)))return mkDate(+m[3],+m[2],m[1],ref);
  if((m=s.match(/^(\d{4})(\d{2})(\d{2})/)))return mkDate(+m[3],+m[2],m[1],ref);
  if((m=s.match(/^(\d{1,2})[\/.\-](\d{1,2})(?:[\/.\-](\d{2,4}))?/)))
    return fmt==='mdy'?mkDate(+m[2],+m[1],m[3],ref):mkDate(+m[1],+m[2],m[3],ref);
  const r=dateAtStart(s,ref);return r?r.iso:null;
}
const isDateCell=c=>!!c&&c.length<=30&&(/[\/\-]/.test(c)||/[a-z]/i.test(c))&&!!parseDateCell(c,'dmy');
const isMoneyCell=c=>!!c&&/^\(?[-−+]?\s*(R\$)?\s*[-−]?\s*\d[\d.,]*[.,]\d{1,2}\)?\s*[-DC]?$/i.test(c.trim());

/* ================= CSV ================= */
function decodeText(buf){
  let t;try{t=new TextDecoder('utf-8',{fatal:true}).decode(buf)}catch(e){t=new TextDecoder('windows-1252').decode(buf)}
  return t.replace(/^\uFEFF/,'');
}
function detectDelim(text){
  const lines=text.split(/\r?\n/).filter(l=>l.trim()).slice(0,30);
  let best=',',bs=-1;
  for(const d of [';',',','\t','|']){
    const counts=lines.map(l=>l.split(d).length-1).filter(c=>c>0);if(!counts.length)continue;
    const freq={};counts.forEach(c=>freq[c]=(freq[c]||0)+1);
    const [mode,mf]=Object.entries(freq).sort((a,b)=>b[1]-a[1])[0];
    const score=mf*10+Math.min(+mode,9);if(score>bs){bs=score;best=d}
  }
  return best;
}
function parseCSV(text,delim){
  const rows=[];let row=[],f='',q=false;
  for(let i=0;i<text.length;i++){const c=text[i];
    if(q){if(c==='"'){if(text[i+1]==='"'){f+='"';i++}else q=false}else f+=c}
    else if(c==='"'&&f.trim()==='')q=true;
    else if(c===delim){row.push(f);f=''}
    else if(c==='\n'){row.push(f);rows.push(row);row=[];f=''}
    else if(c!=='\r')f+=c;
  }
  if(f!==''||row.length){row.push(f);rows.push(row)}
  return rows.map(r=>r.map(x=>x.trim())).filter(r=>r.some(x=>x!==''));
}
function guessMapping(rows,delim){
  const map={delimiter:delim,headerRow:-1,dataStart:0,dateCol:-1,descCol:-1,desc2Col:-1,valueMode:'single',valueCol:-1,creditCol:-1,debitCol:-1,dateFormat:'dmy',decimal:'auto',invert:false};
  let first=-1;
  for(let i=0;i<Math.min(rows.length,80);i++){const r=rows[i];if(r.some(isDateCell)&&r.some(isMoneyCell)){first=i;break}}
  if(first<0){first=rows.length>1?1:0;map.headerRow=rows.length>1?0:-1}
  else for(let j=first-1;j>=Math.max(0,first-3);j--){if(rows[j].filter(c=>/[A-Za-z]/.test(c)).length>=2){map.headerRow=j;break}}
  map.dataStart=first;
  const H=map.headerRow>=0?rows[map.headerRow].map(norm):[];
  const sample=rows.slice(first,first+40);
  const ncol=Math.max(1,H.length,...sample.map(r=>r.length));
  const frac=(fn,c)=>{const v=sample.map(r=>r[c]).filter(x=>x);return v.length?v.filter(fn).length/v.length:0};
  const find=(re,skip=[])=>H.findIndex((h,i)=>!skip.includes(i)&&re.test(h));
  map.dateCol=find(/^DATA|^DATE|^DT\b|DATA (DE |DO )?(LANC|COMPRA|MOV)/);
  if(map.dateCol<0||frac(isDateCell,map.dateCol)<.5){let b=-1,bf=0;for(let c=0;c<ncol;c++){const f=frac(isDateCell,c);if(f>bf){bf=f;b=c}}map.dateCol=b}
  const moneyCols=[];for(let c=0;c<ncol;c++)if(c!==map.dateCol&&frac(isMoneyCell,c)>=.5)moneyCols.push(c);
  const cr=find(/CREDITO|ENTRADA/,[map.dateCol]),db=find(/DEBITO|SAIDA/,[map.dateCol]);
  const val=H.findIndex((h,i)=>i!==map.dateCol&&/VALOR|AMOUNT|QUANTIA|MONTANTE|VALUE|VLR/.test(h)&&!/SALDO|BALANCE|DOLAR|USD|US\$/.test(h));
  if(cr>=0&&db>=0&&cr!==db){map.valueMode='split';map.creditCol=cr;map.debitCol=db}
  else if(val>=0)map.valueCol=val;
  else{const ns=moneyCols.filter(c=>!/SALDO|BALANCE/.test(H[c]||''));map.valueCol=ns.length?ns[0]:(moneyCols[0]??-1)}
  const used=[map.dateCol,map.valueCol,map.creditCol,map.debitCol];
  const dRe=/DESCRI|HISTORICO|LANCAMENTO|ESTABELECIMENTO|TITLE|MEMO|DETALHE|TRANSACAO|NOME|BENEFICI/;
  map.descCol=find(dRe,used);
  if(map.descCol>=0){const d2=find(dRe,[...used,map.descCol]);if(d2>=0)map.desc2Col=d2}
  else{let b=-1,bl=-1;for(let c=0;c<ncol;c++){if(used.includes(c)||moneyCols.includes(c))continue;
      const avg=sample.reduce((s,r)=>s+((r[c]||'').replace(/[^A-Za-zÀ-ÿ]/g,'').length),0)/Math.max(sample.length,1);if(avg>bl){bl=avg;b=c}}map.descCol=b}
  if(map.dateCol>=0){for(const r of sample){const m=(r[map.dateCol]||'').match(/^(\d{1,2})[\/.\-](\d{1,2})/);if(!m)continue;
    if(+m[1]>12){map.dateFormat='dmy';break}if(+m[2]>12){map.dateFormat='mdy';break}}}
  return map;
}
function csvSig(rows,map){
  const h=map.headerRow>=0&&rows[map.headerRow]?'H:'+rows[map.headerRow].map(norm).join('|'):'N:'+((rows[map.dataStart]||[]).length);
  return h+'#'+map.delimiter;
}
function applyMapping(rows,map,ref){
  const out=[];
  for(let i=map.dataStart;i<rows.length;i++){if(i===map.headerRow)continue;const r=rows[i];
    const date=parseDateCell(r[map.dateCol],map.dateFormat,ref);if(!date)continue;
    let amount;
    if(map.valueMode==='split'){const c=parseMoney(r[map.creditCol],map.decimal),d=parseMoney(r[map.debitCol],map.decimal);
      if(isNaN(c)&&isNaN(d))continue;amount=(isNaN(c)?0:Math.abs(c))-(isNaN(d)?0:Math.abs(d))}
    else{amount=parseMoney(r[map.valueCol],map.decimal);if(isNaN(amount))continue}
    if(map.invert)amount=-amount;
    let desc=(r[map.descCol]||'').trim();
    if(map.desc2Col>=0&&r[map.desc2Col])desc=(desc?desc+' · ':'')+r[map.desc2Col].trim();
    out.push({date,desc:desc||'(sem descrição)',amount:round2(amount),suspect:/\bSALDO\b/.test(norm(desc))||amount===0});
  }
  return out;
}

/* ================= OFX ================= */
function parseOFX(text){
  const out=[];const re=/<STMTTRN>([\s\S]*?)(?=<\/STMTTRN>|<STMTTRN>|<\/BANKTRANLIST>|$)/gi;let m;
  while((m=re.exec(text))){const b=m[1];
    const tag=t=>{const x=b.match(new RegExp('<'+t+'>([^<\\r\\n]*)','i'));return x?x[1].trim():''};
    const date=parseDateCell(tag('DTPOSTED').slice(0,8));const amt=parseFloat(tag('TRNAMT').replace(',','.'));
    const desc=[tag('NAME'),tag('MEMO')].filter(Boolean).filter((v,i,a)=>a.indexOf(v)===i).join(' · ')||tag('TRNTYPE');
    if(date&&!isNaN(amt))out.push({date,desc,amount:round2(amt)});
  }
  return out;
}

